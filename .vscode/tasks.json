{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "postTitle",
      "type": "promptString",
      "description": "文章标题（文件名也会用它，建议英文）",
      "default": "new-post"
    }
  ],
  "tasks": [
    {
      "label": "预览站点",
      "detail": "启动本地预览 http://localhost:4000 ，改文件会自动刷新；停止按 Ctrl+C",
      "type": "shell",
      "command": "npx hexo server -p 4000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "INFO  Start processing",
          "endsPattern": "Hexo is running at"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "新建文章",
      "detail": "在 source/_posts/ 下按模板生成一篇带 front-matter 的文章",
      "type": "shell",
      "command": "npx hexo new post \"${input:postTitle}\"",
      "problemMatcher": []
    },
    {
      "label": "本地构建",
      "detail": "生成 public/ 目录（只验证能不能构建成功，发布由 GitHub Actions 负责）",
      "type": "shell",
      "command": "npx hexo generate",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "清理缓存",
      "detail": "npx hexo clean，改了配置或主题后先跑这个",
      "type": "shell",
      "command": "npx hexo clean",
      "problemMatcher": []
    }
  ]
}
